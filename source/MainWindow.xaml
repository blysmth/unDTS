<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="unDTS" Width="1120" Height="850" MinWidth="880" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#101319" Foreground="#E6EAF0" FontFamily="Segoe UI" FontSize="13" AllowDrop="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#8B98AD"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E6EAF0"/><Setter Property="Background" Value="#242D3C"/>
   <Setter Property="BorderBrush" Value="#344155"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="17,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListViewItem"><Setter Property="ToolTip" Value="{Binding Detail}"/><Setter Property="Foreground" Value="#DCE3EF"/><Setter Property="Padding" Value="6,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Row" Background="Transparent" CornerRadius="4"><GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#253449"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#1D2531"/><Setter Property="Foreground" Value="#8B98AD"/><Setter Property="Padding" Value="6,7"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="LayoutRoot" Margin="28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><StackPanel><Image x:Name="Logo" Width="320" Height="106" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="unDTS" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Convert you mkv DTS audio to AC3" Foreground="{StaticResource Muted}" FontSize="11" Margin="1,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#142C26" BorderBrush="#275347" BorderThickness="1" CornerRadius="14" Padding="12,6"><TextBlock x:Name="Badge" Text="●  READY" Foreground="#72EDB3" FontSize="11"/></Border></Grid>
  <Border Grid.Row="1" x:Name="DropZone" CornerRadius="10" BorderBrush="#36536B" BorderThickness="1" Background="#16212C" Padding="19,16" Margin="0,0,0,16"><Grid><StackPanel><TextBlock Text="＋  Drop MKV files or folders here" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Batch conversion · originals kept · results saved beside each source" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Button x:Name="Add" Content="Browse files…" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  <Border Grid.Row="2" Background="#181E28" CornerRadius="10" BorderBrush="#2B3544" BorderThickness="1" Padding="20,16" Margin="0,0,0,14">
   <StackPanel><Grid><StackPanel><TextBlock Text="CONVERSION PROGRESS" FontSize="10" Foreground="{StaticResource Muted}"/><Border x:Name="FilenameHost" Margin="0,5,110,0"/></StackPanel><TextBlock x:Name="Percent" Text="0.0%" FontFamily="Consolas" FontSize="29" Foreground="#79EFBD" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Grid Margin="0,13,0,5"><TextBlock Text="LIVE OUTPUT BITRATE  /  LAST 60 SECONDS" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="Bitrate" Text="-- Mb/s" FontFamily="Consolas" FontSize="18" Foreground="#79EFBD" HorizontalAlignment="Right"/></Grid>
    <Border x:Name="GraphHost" ToolTip="Isolated spikes are capped in amber; the scale expands for consecutive high readings. The live number shows the actual bitrate." Height="128" Margin="0,0,0,5"/>
    <TextBlock Text="Video + audio + container • measured per interval of media time" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
    <ProgressBar x:Name="UnknownProgress" Visibility="Collapsed" IsIndeterminate="True" Height="3" Foreground="#73EABD" Margin="0,0,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="ELAPSED" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Elapsed" Text="00:00:00" FontFamily="Consolas" FontSize="21" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="REMAINING · EST." FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Remaining" Text="—" FontFamily="Consolas" FontSize="21" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="CONVERSION SPEED" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Speed" Text="—" Foreground="#7CC2FF" FontFamily="Consolas" FontSize="21" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="3"><TextBlock Text="OUTPUT SIZE" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="Size" Text="—" Foreground="#C5A4FF" FontFamily="Consolas" FontSize="21" Margin="0,5,0,0"/></StackPanel>
    </Grid>
   </StackPanel>
  </Border>
  <Grid Grid.Row="3" Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><TextBlock Text="CONVERSION QUEUE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="QueueCount" Text="  /  0 files" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Remove" Content="Remove selected" Padding="10,5" Margin="0,0,8,0"/><Button x:Name="Clear" Content="Clear finished" Padding="10,5"/></StackPanel></Grid>
  <Border Grid.Row="4" Background="#141A23" CornerRadius="8" BorderBrush="#2B3544" BorderThickness="1" Height="180"><ListView x:Name="Queue" Background="Transparent" BorderThickness="0" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListView.View><GridView><GridViewColumn Header="FILE" Width="510" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="SOURCE SIZE" Width="120" DisplayMemberBinding="{Binding Size}"/><GridViewColumn Header="STATUS" Width="230" DisplayMemberBinding="{Binding Status}"/></GridView></ListView.View></ListView></Border>
  <StackPanel Grid.Row="5" Margin="0,12,0,0"><CheckBox x:Name="AllTracks" Foreground="#C2CDDE" Content="Include all audio, subtitle tracks and attachments (convert every audio track to AC3)"/><TextBlock Text="Default: Audio track marked default (otherwise the most channels), plus the first subtitle track." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,10"/>
   <Expander x:Name="LogExpander" Header="FFmpeg details &amp; conversion log" Foreground="#B8C4D5"><Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="Log" Background="#0D1118" Foreground="#A5C4B9" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderBrush="#2B3544" Padding="8"/><Button x:Name="SaveLog" Grid.Row="1" Content="Save full log…" Padding="10,5" HorizontalAlignment="Right" Margin="0,6,0,0"/></Grid></Expander>
  </StackPanel>
  <Grid Grid.Row="6" Margin="0,16,0,0"><TextBlock x:Name="Summary" Text="Ready when you are." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="OpenFolder" Content="Open output folder" Margin="0,0,10,0" IsEnabled="False"/><Button x:Name="Cancel" Content="Stop batch" Margin="0,0,10,0" IsEnabled="False"/><Button x:Name="Start" Content="▶  Convert queue" Background="#246F59" BorderBrush="#388F73" FontWeight="SemiBold"/></StackPanel></Grid>
 </Grid></ScrollViewer>
</Window>
